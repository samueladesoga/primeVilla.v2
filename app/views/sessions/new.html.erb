<% content_for :title, "Log in" %>

<div class="form-card mt-8">
  <h1 class="page-title">Log in</h1>
  <%= form_with url: session_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email address", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>
    <div class="field">
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <%= form.submit "Log in", class: "btn-primary" %>
      <%= link_to "Forgot password?", new_password_path, class: "text-sm text-gray-700 underline" %>
    </div>
  <% end %>
</div>
