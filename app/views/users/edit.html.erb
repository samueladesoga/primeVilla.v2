<% content_for :title, "Edit #{@user.name}" %>

<div class="form-card">
  <h1 class="page-title">Edit tenant</h1>
  <%= form_with model: @user do |form| %>
    <%= render "shared/form_errors", record: @user %>
    <%= render "users/contact_fields", form: form %>
    <div class="flex flex-wrap gap-3">
      <%= form.submit "Save changes", class: "btn-primary" %>
      <%= link_to "Cancel", user_path(@user), class: "btn-secondary" %>
    </div>
  <% end %>
</div>
