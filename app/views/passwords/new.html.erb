<% content_for :title, "Forgot password" %>

<div class="form-card mt-8">
  <h1 class="page-title mb-2">Forgot your password?</h1>
  <p class="text-sm text-gray-600 mb-6">Enter your email and we'll send you a link to set a new one.</p>
  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email address", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <%= form.submit "Email me a link", class: "btn-primary" %>
      <%= link_to "Back to log in", new_session_path, class: "text-sm text-gray-700 underline" %>
    </div>
  <% end %>
</div>
