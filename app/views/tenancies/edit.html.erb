<% content_for :title, "Edit tenancy" %>

<div class="form-card">
  <h1 class="page-title mb-2">Edit tenancy</h1>
  <p class="text-sm text-gray-600 mb-6">
    To record a new rent payment, <%= link_to "renew this tenancy", renew_tenancy_path(@tenancy), class: "link" %> instead, so the history is kept.
  </p>
  <%= render "form", tenancy: @tenancy, submit_label: "Save changes", cancel_path: tenancy_path(@tenancy) %>
</div>
