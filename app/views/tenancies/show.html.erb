<% content_for :title, "Tenancy" %>

<h1 class="page-title">Tenancy</h1>

<%= render @tenancy %>

<div class="mt-6 flex flex-wrap gap-3">
  <% if @tenancy.is_active? %>
    <%= link_to "Renew", renew_tenancy_path(@tenancy), class: "btn-success" %>
  <% end %>
  <%= link_to "Edit", edit_tenancy_path(@tenancy), class: "btn-secondary" %>
  <%= link_to "Back to tenancies", tenancies_path, class: "btn-secondary" %>
  <% if @tenancy.is_active? %>
    <%= button_to "End tenancy", @tenancy, method: :delete, params: { return_to: "show" }, class: "btn-danger",
          data: { turbo_confirm: "End this tenancy and mark #{@tenancy.room.name} as empty?" } %>
  <% end %>
</div>
