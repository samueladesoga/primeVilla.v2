<% content_for :title, "Tenancies" %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <h1 class="page-title mb-0">Tenancies</h1>
  <div class="flex flex-wrap gap-3">
    <%= link_to "Download PDF", tenancies_path(format: :pdf), class: "btn-secondary", data: { turbo: false } %>
    <%= link_to "+ Assign room", new_tenancy_path, class: "btn-success" %>
  </div>
</div>

<div class="bg-white border border-gray-200 rounded-xl overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th>Room</th>
        <th>Tenant</th>
        <th class="hidden md:table-cell">Parent / next of kin</th>
        <th class="hidden sm:table-cell">Start</th>
        <th class="hidden sm:table-cell">End</th>
        <th>Status</th>
        <th class="hidden lg:table-cell">Notes</th>
        <th><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "room_row", collection: @rooms, as: :room %>
    </tbody>
  </table>
</div>
