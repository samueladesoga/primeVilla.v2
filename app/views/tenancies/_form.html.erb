<%= form_with(model: tenancy, url: tenancy.persisted? ? tenancy_path(tenancy) : tenancies_path) do |form| %>
  <%= render "shared/form_errors", record: tenancy %>
  <%= hidden_field_tag :previous_tenancy_id, @previous_tenancy.id if @previous_tenancy %>

  <div class="field">
    <%= form.label :user_id, "Tenant", class: "label" %>
    <%= form.collection_select :user_id, tenant_options_for(tenancy), :id, :name,
          { include_blank: "Select a tenant" }, { class: "input", required: true } %>
    <p class="hint"><%= tenancy.user ? "Lists this tenant and anyone without a room." : "Only tenants without a room are listed." %> <%= link_to "Create a new tenant", new_registrations_path, class: "link" %></p>
  </div>

  <div class="field">
    <%= form.label :room_id, "Room", class: "label" %>
    <%= form.collection_select :room_id, room_options_for(tenancy), :id, :name,
          { include_blank: "Select a room" }, { class: "input", required: true } %>
    <p class="hint"><%= tenancy.room ? "Lists this room and all vacant rooms." : "Only vacant rooms are listed." %></p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="field">
      <%= form.label :start_date, class: "label" %>
      <%= form.text_field :start_date, placeholder: "Select a start date", class: "input", required: true, data: { controller: "date-picker" } %>
    </div>
    <div class="field">
      <%= form.label :end_date, class: "label" %>
      <%= form.text_field :end_date, placeholder: "Select an end date", class: "input", required: true, data: { controller: "date-picker" } %>
    </div>
  </div>

  <div class="field">
    <%= form.label :comments, "Notes", class: "label" %>
    <%= form.text_area :comments, rows: 3, class: "input", placeholder: "e.g. amount paid, payment reference" %>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit submit_label, class: "btn-primary" %>
    <%= link_to "Cancel", cancel_path, class: "btn-secondary" %>
  </div>
<% end %>
