<% content_for :title, @previous_tenancy ? "Renew tenancy" : "Assign room" %>

<div class="form-card">
  <% if @previous_tenancy %>
    <h1 class="page-title mb-2">Renew tenancy</h1>
    <p class="text-sm text-gray-600 mb-6">
      Current tenancy for <strong><%= @previous_tenancy.user.name %></strong> in <strong><%= @previous_tenancy.room.name %></strong>
      ends <%= l(@previous_tenancy.end_date) %>. Saving will end it and start this one.
    </p>
  <% else %>
    <h1 class="page-title">Assign a room</h1>
  <% end %>

  <%= render "form", tenancy: @tenancy,
        submit_label: @previous_tenancy ? "Renew tenancy" : "Create tenancy",
        cancel_path: @previous_tenancy ? tenancy_path(@previous_tenancy) : tenancies_path %>
</div>
