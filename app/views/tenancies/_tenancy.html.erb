<div id="<%= dom_id tenancy %>" class="card max-w-xl">
  <div class="flex items-start justify-between gap-4 mb-4">
    <div>
      <p class="text-sm text-gray-500">Tenant</p>
      <%= link_to tenancy.user.name, tenancy.user, class: "text-xl font-semibold hover:underline" %>
    </div>
    <%= tenancy_status_badge(tenancy) %>
  </div>
  <dl class="grid grid-cols-2 gap-4 text-sm">
    <div><dt class="text-gray-500">Room</dt><dd class="font-medium"><%= link_to tenancy.room.name, tenancy.room, class: "hover:underline" %></dd></div>
    <div><dt class="text-gray-500">Phone</dt><dd class="font-medium"><%= tenancy.user.phone_number.presence || "—" %></dd></div>
    <div><dt class="text-gray-500">Start date</dt><dd class="font-medium"><%= l(tenancy.start_date) %></dd></div>
    <div><dt class="text-gray-500">End date</dt><dd class="font-medium"><%= l(tenancy.end_date) %></dd></div>
    <div class="col-span-2"><dt class="text-gray-500">Notes</dt><dd class="whitespace-pre-line"><%= tenancy.comments.presence || "—" %></dd></div>
  </dl>
</div>
