<h1 class="page-title">Dashboard</h1>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <%= link_to tenancies_path, class: "card hover:border-yellow-700" do %>
    <p class="text-sm text-gray-500">Occupied</p>
    <p class="text-3xl font-bold"><%= @occupied_count %><span class="text-base font-normal text-gray-500"> / <%= @room_count %></span></p>
  <% end %>
  <a href="#vacant" class="card hover:border-yellow-700">
    <p class="text-sm text-gray-500">Vacant rooms</p>
    <p class="text-3xl font-bold"><%= @vacant_rooms.size %></p>
  </a>
  <a href="#expiring" class="card hover:border-yellow-700">
    <p class="text-sm text-gray-500">Expiring in 30 days</p>
    <p class="text-3xl font-bold text-amber-600"><%= @expiring_tenancies.size %></p>
  </a>
  <a href="#overdue" class="card hover:border-yellow-700">
    <p class="text-sm text-gray-500">Overdue</p>
    <p class="text-3xl font-bold text-red-600"><%= @overdue_tenancies.size %></p>
  </a>
</div>

<div class="space-y-6">
  <section id="overdue" class="card">
    <h2 class="card-title">Overdue tenancies</h2>
    <%= render "tenancy_list", tenancies: @overdue_tenancies, empty_message: "No tenancies are overdue." %>
  </section>

  <section id="expiring" class="card">
    <h2 class="card-title">Expiring in the next 30 days</h2>
    <%= render "tenancy_list", tenancies: @expiring_tenancies, empty_message: "No tenancies expire in the next 30 days." %>
  </section>

  <section id="vacant" class="card">
    <h2 class="card-title">Vacant rooms</h2>
    <% if @vacant_rooms.empty? %>
      <p class="text-gray-500">Every room is occupied.</p>
    <% else %>
      <ul class="divide-y divide-gray-100">
        <% @vacant_rooms.each do |room| %>
          <li class="flex items-center justify-between py-2">
            <%= link_to room.name, room, class: "font-medium hover:underline" %>
            <%= link_to "Assign tenant", new_tenancy_path(room_id: room.id), class: "link text-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
