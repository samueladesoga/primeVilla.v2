<% if tenancies.empty? %>
  <p class="text-gray-500"><%= empty_message %></p>
<% else %>
  <ul class="divide-y divide-gray-100">
    <% tenancies.each do |tenancy| %>
      <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 py-3">
        <div>
          <%= link_to tenancy.user.name, tenancy.user, class: "font-medium hover:underline" %>
          <span class="text-gray-500">· <%= tenancy.room.name %></span>
          <div class="text-sm text-gray-500">Ends <%= l(tenancy.end_date) %> <%= tenancy_status_badge(tenancy) %></div>
        </div>
        <div class="flex gap-3 text-sm">
          <%= link_to "Renew", renew_tenancy_path(tenancy), class: "btn-success py-1" %>
          <%= link_to "View", tenancy, class: "btn-secondary py-1" %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
