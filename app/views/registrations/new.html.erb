<% content_for :title, "New tenant" %>

<div class="form-card">
  <h1 class="page-title mb-2">New tenant</h1>
  <p class="text-sm text-gray-600 mb-6">They'll get an email with a link to set their own password. You'll assign a room next.</p>

  <%= form_with model: @user, url: registrations_path do |form| %>
    <%= render "shared/form_errors", record: @user %>
    <%= render "users/contact_fields", form: form %>
    <div class="flex flex-wrap gap-3">
      <%= form.submit "Create tenant", class: "btn-primary" %>
      <%= link_to "Cancel", users_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
