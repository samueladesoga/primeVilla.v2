<%= form_with(model: room) do |form| %>
  <%= render "shared/form_errors", record: room %>
  <div class="field">
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input", required: true, autofocus: true, placeholder: "e.g. Room 12" %>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn-primary" %>
    <%= link_to "Cancel", room.persisted? ? room_path(room) : rooms_path, class: "btn-secondary" %>
  </div>
<% end %>
