<% content_for :title, "Rooms" %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <h1 class="page-title mb-0">Rooms</h1>
  <%= link_to "+ New room", new_room_path, class: "btn-success" %>
</div>

<div class="bg-white border border-gray-200 rounded-xl overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th>Room</th>
        <th>Status</th>
        <th class="hidden sm:table-cell">Current tenant</th>
        <th><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @rooms.each do |room| %>
        <tr>
          <td class="font-medium whitespace-nowrap"><%= link_to room.name, room, class: "hover:underline" %></td>
          <td><%= room.occupied? ? tag.span("Occupied", class: "badge-green") : tag.span("Vacant", class: "badge-gray") %></td>
          <td class="hidden sm:table-cell"><%= room.active_tenancy ? link_to(room.active_tenancy.user.name, room.active_tenancy, class: "hover:underline") : "—" %></td>
          <td>
            <div class="flex flex-wrap gap-3">
              <% unless room.occupied? %>
                <%= link_to "Assign tenant", new_tenancy_path(room_id: room.id), class: "link" %>
              <% end %>
              <%= link_to "Edit", edit_room_path(room), class: "link" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
