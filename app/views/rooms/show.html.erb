<% content_for :title, @room.name %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <h1 class="page-title mb-0"><%= @room.name %></h1>
  <div class="flex flex-wrap gap-3">
    <% if @room.occupied? %>
      <%= link_to "Renew current tenancy", renew_tenancy_path(@room.active_tenancy), class: "btn-success" %>
    <% else %>
      <%= link_to "Assign tenant", new_tenancy_path(room_id: @room.id), class: "btn-success" %>
    <% end %>
    <%= link_to "Edit", edit_room_path(@room), class: "btn-secondary" %>
    <% if @tenancies.empty? %>
      <%= button_to "Delete room", @room, method: :delete, class: "btn-danger", data: { turbo_confirm: "Delete #{@room.name}?" } %>
    <% end %>
  </div>
</div>

<section class="card">
  <h2 class="card-title">Tenancy history</h2>
  <% if @tenancies.empty? %>
    <p class="text-gray-500">No one has rented this room yet.</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr><th>Tenant</th><th>Start</th><th>End</th><th>Status</th><th class="hidden md:table-cell">Notes</th></tr>
        </thead>
        <tbody>
          <% @tenancies.each do |tenancy| %>
            <tr>
              <td><%= link_to tenancy.user.name, tenancy, class: "hover:underline" %></td>
              <td><%= l(tenancy.start_date) %></td>
              <td><%= l(tenancy.end_date) %></td>
              <td><%= tenancy_status_badge(tenancy) %></td>
              <td class="hidden md:table-cell"><%= tenancy.comments %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

<p class="mt-6"><%= link_to "← Back to rooms", rooms_path, class: "link" %></p>
